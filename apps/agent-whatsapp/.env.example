# ============================================================================
# Don Zarco Orders — variables de entorno
#
# PLANTILLA SIN SECRETOS. Este archivo SÍ se versiona en git.
#
#   NUNCA escribas un valor real aquí. Copia el archivo a `.env.local` y pon
#   ahí las credenciales: `.env.local` está en .gitignore y no viaja al repo.
#
#       cp .env.example .env.local
#
# La validación es LAZY: nada falla al arrancar ni al hacer build. Una variable
# que falta rompe solo la función que la necesita, la primera vez que se usa.
# Por eso puedes levantar el proyecto con lo mínimo e ir agregando el resto.
#
# Una variable presente pero VACÍA cuenta como ausente en todo el proyecto.
# ============================================================================

# ── Supabase — REQUERIDAS ───────────────────────────────────────────────────
# Sin estas dos no funciona nada que toque la base.
# Dashboard de Supabase → Project Settings → API.
SUPABASE_URL=
# SECRETO. Omite RLS. Nunca la pegues en un chat, issue o log.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional. Esquema de las tablas del agente; vacío = public.
# Pon `agent` cuando el agente comparte proyecto de Supabase con el backend
# central (las tablas las crea `node scripts/agent-db.mjs` desde la raíz).
SUPABASE_DB_SCHEMA=

# ── Perfil del restaurante (respaldo) ────────────────────────────────────────
# Con el POS conectado (CENTRAL_API_*), el nombre, el horario, la dirección, la
# moneda y lo que se puede pedir llegan de su `GET /restaurant/profile` y NADA
# de esto hace falta. Estas variables son el respaldo: valen si el POS no
# responde, y campo por campo para lo que el POS deje vacío.
# Ver src/lib/restaurant/profile.ts.
RESTAURANT_NAME=
# Qué vende y dónde, en una línea: "un bar de comida brasileña en Santa Cruz".
RESTAURANT_DESCRIPTION=
# Idioma (BCP 47), zona horaria (IANA) y moneda. Por defecto es-BO,
# America/La_Paz, BOB y Bs.
RESTAURANT_LOCALE=
RESTAURANT_TIMEZONE=
RESTAURANT_CURRENCY_CODE=
RESTAURANT_CURRENCY_SYMBOL=
RESTAURANT_PHONE=
RESTAURANT_ADDRESS=
RESTAURANT_MAPS_URL=
# Horario: apertura y cierre en HH:MM (cierre menor = madrugada siguiente) y los
# días que no abre, de 0 (domingo) a 6 (sábado), separados por coma.
RESTAURANT_OPENS=
RESTAURANT_CLOSES=
RESTAURANT_CLOSED_DAYS=
# El horario en palabras, para que el asistente lo repita tal cual. Opcional.
RESTAURANT_HOURS=
# Qué se ofrece. Por defecto: retiro y envío activos, pagos "cash,qr".
RESTAURANT_PICKUP_ENABLED=
RESTAURANT_DELIVERY_ENABLED=
RESTAURANT_PAYMENT_METHODS=
# Saludo propio para el primer mensaje del menú. Opcional.
RESTAURANT_GREETING=
# Cabecera del botón "Ver menú": video (MP4 H.264 Baseline) o imagen (JPEG o
# PNG). URL pública con https. Sin ninguna, el botón sale solo con el texto.
MENU_VIDEO_URL=
MENU_IMAGE_URL=
# Logo del menú web: una URL, o una ruta de public/ como /brand/logo.png. No
# viene del POS. Sin logo se muestra la inicial del nombre.
RESTAURANT_LOGO_URL=
# Reserva de mesas en el menú web: `true` muestra el formulario, que abre el
# chat de WhatsApp con la reserva escrita para que el local la confirme.
# Necesita WHATSAPP_BUSINESS_NUMBER. Apagado si se deja vacío.
RESTAURANT_RESERVATIONS_ENABLED=
# QR de pago fijo. Solo lo usa el modo sin POS: con el POS conectado, el QR lo
# genera y lo manda el POS.
PAYMENT_QR_URL=

# ── URL pública de la app ───────────────────────────────────────────────────
# En local: http://localhost:3000
# En Vercel: el dominio real del deployment.
APP_BASE_URL=http://localhost:3000

# ── Menú web ────────────────────────────────────────────────────────────────
# Secreto HMAC-SHA256 que firma los tokens de sesión del menú. Genera uno largo
# y aleatorio: openssl rand -hex 32
MENU_SESSION_SECRET=

# ── Acceso interno (/dashboard y /cocina) ───────────────────────────────────
# Aquí NO van contraseñas. Desde la migración 0020 cada persona tiene su propio
# usuario y su rol en la tabla `dashboard_users`; el rol decide a qué pantalla
# entra (admin → /dashboard, kitchen → /cocina). Ver docs/SETUP.md para dar de
# alta usuarios.
#
# Mínimo 32 caracteres. Firma la cookie de sesión: openssl rand -hex 32
# Si falta, el acceso queda CERRADO y no autentica a nadie (fail-closed).
DASHBOARD_SESSION_SECRET=

# ── Comprobantes de pago (almacenamiento S3 del agente) ─────────────────────
# SOLO para el modo sin POS. Con el POS conectado los comprobantes se le
# entregan a él, que los guarda en su propio almacenamiento: dejar esto vacío.
# El ejemplo de abajo es de Cloudflare R2, que usaba la demo; sirve cualquier
# almacenamiento compatible con S3.
# Los clientes que pagan por QR mandan su comprobante por WhatsApp. Se guardan
# en un bucket PRIVADO: sin dominio público conectado, y la app nunca genera una
# URL pública ni firmada — los sirve por su propio endpoint autenticado.
#
# Si falta cualquiera de las cuatro, la captura queda apagada (fail-closed).
# En Cloudflare: R2 → Manage API Tokens. OJO: el "Token value" (cfat_...) NO
# sirve aquí; los valores correctos son "Access Key ID" (32 caracteres) y
# "Secret Access Key" (64 caracteres).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# El nombre del BUCKET, no el nombre del token de API.
R2_BUCKET=

# Interruptor de la captura. SOLO la cadena exacta `true` la enciende; ausente,
# vacía o cualquier otro valor la deja apagada.
#
# El default apagado es deliberado: esto corre dentro del webhook que atiende a
# todos los clientes, así que se enciende cuando se decide, no por desplegar.
# Apagarla en producción es cambiar esta variable, sin revertir código.
#
# HACE FALTA 'true' para capturar y MOSTRAR comprobantes en el panel.
#
# Con el flag apagado la privacidad sigue siendo fail-closed: sin motor de
# comprobantes no hay veredicto, y sin veredicto NINGÚN adjunto del cliente
# llega al agente ni a OpenAI. El texto del mensaje sí sigue funcionando.
# Ver docs/payment-proof-agent-gate.md.
PAYMENT_PROOF_CAPTURE_ENABLED=

# ── Análisis automático del comprobante (0025) ──────────────────────────────
# Lee la imagen del comprobante y contrasta el DESTINO del dinero —cuenta,
# titular y banco— más el número de transacción. El monto se lee y se muestra,
# pero no dispara alerta: no se sabe de antemano cuánto va a transferir alguien
# por WhatsApp. NO acepta ni rechaza nada: el
# comprobante llega a cocina igual y decide una persona. Solo marca lo que no
# cuadra para que un vistazo con prisa no se lo salte.
#
# Interruptor: SOLO la cadena exacta `true` lo enciende. Necesita OPENAI_API_KEY.
PAYMENT_PROOF_ANALYSIS_ENABLED=

# La cuenta donde cobra Don Zarco, TAL COMO SALE IMPRESA en el comprobante que
# recibe el cliente — no como figura en el contrato del banco. Si no coincide
# con lo impreso, el análisis marcará como sospechoso cada pago legítimo.
#
# Sin número de cuenta NI titular, el análisis queda apagado aunque el
# interruptor esté en `true`: sin patrón contra el que comparar, un veredicto
# "ok" sería un aprobado que nadie ha dado.
PAYMENT_PROOF_ACCOUNT_BANK=
# Otras formas de escribir ESE banco, separadas por `|`. Hace falta al menos la
# sigla: `BNB` y `Banco Nacional de Bolivia` no comparten ni una palabra, y el
# banco destino SÍ dispara alerta. Ejemplo:
#   PAYMENT_PROOF_ACCOUNT_BANK_ALIASES=BNB|BANCO NACIONAL DE BOLIVIA
PAYMENT_PROOF_ACCOUNT_BANK_ALIASES=
# Cuenta(s) destino. Se comparan por los dígitos finales, así que sirve igual
# entera (1234567890) o como la enmascare el banco (****7890).
#
# Si el negocio cobra por MÁS DE UNA billetera —Yape y Altoke, por ejemplo—, van
# todas separadas por `|`. Basta con que una coincida; con una sola configurada,
# cada pago a la otra saldría acusado como cuenta ajena. Ejemplo:
#   PAYMENT_PROOF_ACCOUNT_NUMBER=78486705|1234567890
PAYMENT_PROOF_ACCOUNT_NUMBER=
# Titular/beneficiario tal como lo pinta el comprobante.
PAYMENT_PROOF_ACCOUNT_HOLDER=
# Otras formas en que los bancos escriben ese MISMO titular, separadas por `|`.
# Basta con que una coincida. Ejemplo:
#   PAYMENT_PROOF_ACCOUNT_HOLDER_ALIASES=DON ZARCO SRL|ZARCO GASTRONOMIA
PAYMENT_PROOF_ACCOUNT_HOLDER_ALIASES=
# Modelo de visión para leer el comprobante. Vacío = `gpt-5-mini`.
#
# NO hereda OPENAI_MODEL a propósito. El default del agente (`gpt-4o-mini`) es
# el más caro de todos para mirar imágenes: su tokenización lleva un
# multiplicador de ~33x, y una captura de banco le sale por unos 48.000 tokens
# de entrada frente a los ~3.000 de `gpt-5-mini`. Mismo trabajo, siete veces el
# precio, y lo lee peor.
PAYMENT_PROOF_ANALYSIS_MODEL=

# ── Delivery dinámico (Mapbox) ──────────────────────────────────────────────
# Sin estas tres, la cotización de delivery no funciona y el checkout falla al
# calcular el envío. El token es server-side: jamás lleva prefijo NEXT_PUBLIC_.
MAPBOX_ACCESS_TOKEN=
# Coordenadas del local (origen de la ruta). Solo las usa el modo sin POS: con
# el POS conectado, el envío lo cotiza el POS con las coordenadas de su perfil.
RESTAURANT_LAT=
RESTAURANT_LNG=
# Opcional. Timeout de Mapbox Directions en ms (default: 5000).
MAPBOX_DIRECTIONS_TIMEOUT_MS=

# ── Kapso (WhatsApp) ────────────────────────────────────────────────────────
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
# El número de WhatsApp del negocio, el que ve el cliente, con código de país
# (p. ej. 59170000000). Es el botón "Ir a WhatsApp para pagar" de la pantalla
# de pedido registrado. Vacía = esa pantalla queda sin botón.
WHATSAPP_BUSINESS_NUMBER=
# Se copia DESPUÉS de crear el webhook en Kapso. Sin ella el webhook rechaza
# todo con 401, que es el comportamiento seguro por defecto.
KAPSO_WEBHOOK_SECRET=
# Omítela: sin esta variable se usa la URL oficial de Kapso.
KAPSO_API_BASE_URL=

# ── Endpoints internos (workers) ────────────────────────────────────────────
# Valor aleatorio largo que tú generas; NO viene de ningún proveedor. Protege
# las rutas /api/internal/* y /api/flow/*.
#
# NO renombrar a VERCEL_ALGO: Vercel reserva el prefijo `VERCEL_` para sus
# variables de sistema y rechaza la importación con "variable is invalid".
#
# El backend lleva este mismo valor en su `AGENT_INTERNAL_TOKEN`: cada minuto
# llama a las cuatro rutas de recuperación de este agente (su despertador, ver
# apps/backend/src/agent-wake). Si cambias uno, cambia el otro o recibe 401.
# Este proyecto NO usa ningún Worker de Cloudflare.
INTERNAL_API_TOKEN=

# ── Alertas por Telegram (opcional) ─────────────────────────────────────────
# Si faltan, el worker no envía alertas y el resto del tick sigue igual.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Botones del aviso de un pedido (Listo / Salió / Entregado). Valor aleatorio
# largo que tú generas: Telegram lo manda en cada toque y el agente lo comprueba.
# Sin él, los avisos salen sin botones. Después de publicar hay que registrar el
# webhook UNA vez:
#   node scripts/set-telegram-webhook.mjs https://<este-sitio>
TELEGRAM_WEBHOOK_SECRET=
# Chat para los avisos de "aquí hace falta una persona": quejas, reclamos y
# clientes que no consiguen pedir. Separado del grupo de reparto porque ahí
# serían ruido para quien está montado en una moto.
#
# Vacío = se usa TELEGRAM_CHAT_ID. Un aviso en el grupo equivocado sirve más
# que ninguno.
TELEGRAM_HANDOFF_CHAT_ID=

# ── Agente de WhatsApp (opcional) ───────────────────────────────────────────
# Si falta cualquiera, el agente no llama a OpenAI y el sistema se comporta
# exactamente como antes de que existiera.
#
# Interruptor general: SOLO la cadena 'true' lo enciende.
AI_ENABLED=
# A quién atiende: 'all' abre a cualquier teléfono. Cualquier otro valor
# —ausente, vacío o con un typo— deja el modo 'allowlist' (cerrado).
AI_ACCESS_MODE=
# Lista de teléfonos separados por coma, por coincidencia exacta de dígitos.
AI_TEST_PHONES=
OPENAI_API_KEY=
# Modelo del agente para conversar. Vacío = gpt-4o-mini, que es el más barato
# para TEXTO.
OPENAI_MODEL=
# Modelo del agente SOLO para los turnos en los que el cliente mandó una foto.
# Vacío = se usa OPENAI_MODEL para todo (comportamiento anterior).
#
# Por qué existe: gpt-4o-mini es el más barato en texto y el más caro en imagen
# (~48.000 tokens por una foto de móvil, frente a ~3.000 de gpt-5-mini). Una
# sola foto le cuesta lo mismo que once conversaciones enteras.
#
# Recomendado: gpt-5-mini
AI_VISION_MODEL=

# ── Ajustes finos (opcionales) ──────────────────────────────────────────────
# Minutos que dura la pausa del agente tras un takeover humano.
HUMAN_TAKEOVER_PAUSE_MINUTES=
# ACK durable del webhook: solo 'true' lo enciende. Ausente = procesamiento en
# línea (comportamiento anterior).
WEBHOOK_ASYNC_ACK=

# ── Backend central (el mismo que usa el POS) ────────────────────────────────
# Con las dos primeras definidas, el menú web lee categorías, productos, fotos y
# promociones del backend, y los pedidos se crean allí (aparecen en la cocina
# del POS). Sin ellas, el agente funciona como siempre con sus propias tablas.
CENTRAL_API_BASE_URL=
# Token del api_client "whatsapp-gateway" (SERVICE_AUTH_TOKENS del backend).
CENTRAL_API_TOKEN=
# El backend lo envía como Bearer al llamar a /api/gateway/* para pedir que se
# mande un WhatsApp o un aviso a Telegram. Mismo valor que GATEWAY_AUTH_TOKEN
# en el backend, cuyo GATEWAY_BASE_URL debe ser https://<este-sitio>/api
GATEWAY_AUTH_TOKEN=
