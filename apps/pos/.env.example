# Desarrollo: a dónde reenvía Vite las llamadas a /api (el backend local).
POS_BACKEND_URL=http://localhost:3100

# Producción: URL pública del backend. Si se deja vacío, el POS usa /api
# (hace falta entonces un proxy delante que lo reenvíe al backend).
VITE_API_URL=

# Nombre de respaldo. El real se cambia en Configuración del POS (vive en el backend).
VITE_RESTAURANT_NAME=Restaurante
